{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://land-evaluation-system.vercel.app/schemas/hermes-trace-envelope.schema.json",
  "title": "Hermes run trace envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probe", "run", "artifacts", "observed_at", "audit"],
  "properties": {
    "schema_version": { "const": "1.0.0-phase2b" },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "marker", "expected_artifact_filename", "requested_fresh_session"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "marker": { "type": "string", "minLength": 12 },
        "expected_artifact_filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "requested_fresh_session": { "const": true }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "session_id", "status", "last_event", "output"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9]+$" },
        "session_id": { "type": "string", "minLength": 1 },
        "status": { "const": "completed" },
        "last_event": { "const": "run.completed" },
        "output": { "type": "string", "minLength": 2 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "filename", "sha256", "content_marker"],
        "properties": {
          "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9]+$" },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "content_marker": { "type": "string", "minLength": 12 }
        }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitReport_called",
        "supabase_written",
        "production_modified",
        "main_modified",
        "sensitive_data_present"
      ],
      "properties": {
        "submitReport_called": { "const": false },
        "supabase_written": { "const": false },
        "production_modified": { "const": false },
        "main_modified": { "const": false },
        "sensitive_data_present": { "const": false }
      }
    }
  }
}
